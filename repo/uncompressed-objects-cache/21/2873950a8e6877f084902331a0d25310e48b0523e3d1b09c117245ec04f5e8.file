{
  "id" : "dev.smartcut.app",
  "runtime" : "org.gnome.Platform",
  "runtime-version" : "50",
  "runtime-commit" : "586747ee14069a04d9cb8a39909501cd0f792e1718d244b32ce6d33c288184c6",
  "sdk" : "org.gnome.Sdk",
  "sdk-commit" : "612defccb665c82ca47ea9b17f855317c8714fbfe6773f511bc1bcc3e97a21ab",
  "build-options" : {
    "env" : {
      "CARGO_HOME" : "/run/build/cargo-home",
      "CMAKE_POLICY_VERSION_MINIMUM" : "3.5"
    },
    "append-path" : "/usr/lib/sdk/rust-stable/bin",
    "prepend-pkg-config-path" : "/app/lib/pkgconfig"
  },
  "command" : "smartcut",
  "modules" : [
    {
      "name" : "x264",
      "config-opts" : [
        "--enable-shared",
        "--disable-cli",
        "--enable-pic"
      ],
      "sources" : [
        {
          "url" : "https://code.videolan.org/videolan/x264.git",
          "commit" : "31e19f92f00c7003fa115047ce50978bc98c3a0d",
          "type" : "git"
        }
      ]
    },
    {
      "name" : "x265",
      "subdir" : "source",
      "buildsystem" : "cmake-ninja",
      "builddir" : true,
      "config-opts" : [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_SHARED=ON",
        "-DENABLE_CLI=OFF",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "sources" : [
        {
          "url" : "https://bitbucket.org/multicoreware/x265_git/downloads/x265_4.1.tar.gz",
          "sha256" : "a31699c6a89806b74b0151e5e6a7df65de4b49050482fe5ebf8a4379d7af8f29",
          "type" : "archive"
        },
        {
          "commands" : [
            "sed -i 's/cmake_policy(SET CMP0025 OLD)/cmake_policy(SET CMP0025 NEW)/; s/cmake_policy(SET CMP0054 OLD)/cmake_policy(SET CMP0054 NEW)/' source/CMakeLists.txt"
          ],
          "type" : "shell"
        }
      ]
    },
    {
      "name" : "svt-av1",
      "buildsystem" : "cmake-ninja",
      "config-opts" : [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DBUILD_APPS=OFF",
        "-DBUILD_DEC=OFF",
        "-DBUILD_TESTING=OFF",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "sources" : [
        {
          "url" : "https://gitlab.com/AOMediaCodec/SVT-AV1/-/archive/v2.3.0/SVT-AV1-v2.3.0.tar.gz",
          "sha256" : "ebb0b484ef4a0dc281e94342a9f73ad458496f5d3457eca7465bec943910c6c3",
          "type" : "archive"
        }
      ]
    },
    {
      "name" : "dav1d",
      "buildsystem" : "meson",
      "config-opts" : [
        "--libdir=lib",
        "--buildtype=release",
        "-Denable_tools=false",
        "-Denable_tests=false"
      ],
      "sources" : [
        {
          "url" : "https://code.videolan.org/videolan/dav1d/-/archive/1.5.1/dav1d-1.5.1.tar.gz",
          "sha256" : "fa635e2bdb25147b1384007c83e15de44c589582bb3b9a53fc1579cb9d74b695",
          "type" : "archive"
        }
      ]
    },
    {
      "name" : "libvpx",
      "config-opts" : [
        "--enable-shared",
        "--disable-static",
        "--enable-pic",
        "--enable-vp9-highbitdepth",
        "--disable-examples",
        "--disable-tools",
        "--disable-docs",
        "--disable-unit-tests"
      ],
      "sources" : [
        {
          "url" : "https://github.com/webmproject/libvpx/archive/refs/tags/v1.15.0.tar.gz",
          "sha256" : "e935eded7d81631a538bfae703fd1e293aad1c7fd3407ba00440c95105d2011e",
          "dest-filename" : "libvpx-1.15.0.tar.gz",
          "type" : "archive"
        }
      ]
    },
    {
      "name" : "aom",
      "buildsystem" : "cmake-ninja",
      "builddir" : true,
      "config-opts" : [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DENABLE_DOCS=OFF",
        "-DENABLE_EXAMPLES=OFF",
        "-DENABLE_TESTS=OFF",
        "-DENABLE_TOOLS=OFF",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "sources" : [
        {
          "url" : "https://storage.googleapis.com/aom-releases/libaom-3.12.1.tar.gz",
          "sha256" : "9e9775180dec7dfd61a79e00bda3809d43891aee6b2e331ff7f26986207ea22e",
          "type" : "archive"
        },
        {
          "commands" : [
            "sed -i 's/if(NOT \"${nasm_helptext}\" MATCHES \"-Ox\")/if(FALSE)/' build/cmake/aom_optimization.cmake"
          ],
          "type" : "shell"
        }
      ]
    },
    {
      "name" : "nv-codec-headers",
      "buildsystem" : "simple",
      "sources" : [
        {
          "url" : "https://github.com/FFmpeg/nv-codec-headers/archive/refs/tags/n12.2.72.0.tar.gz",
          "sha256" : "dbeaec433d93b850714760282f1d0992b1254fc3b5a6cb7d76fc1340a1e47563",
          "dest-filename" : "nv-codec-headers-12.2.72.0.tar.gz",
          "type" : "archive"
        }
      ],
      "build-commands" : [
        "make PREFIX=/app install"
      ]
    },
    {
      "name" : "libvpl",
      "buildsystem" : "cmake-ninja",
      "builddir" : true,
      "config-opts" : [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DBUILD_TESTS=OFF",
        "-DBUILD_EXAMPLES=OFF",
        "-DINSTALL_EXAMPLES=OFF",
        "-DBUILD_TOOLS=OFF",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "sources" : [
        {
          "url" : "https://github.com/intel/libvpl/archive/refs/tags/v2.14.0.tar.gz",
          "sha256" : "7c6bff1c1708d910032c2e6c44998ffff3f5fdbf06b00972bc48bf2dd9e5ac06",
          "dest-filename" : "libvpl-2.14.0.tar.gz",
          "type" : "archive"
        }
      ]
    },
    {
      "name" : "rav1e",
      "buildsystem" : "simple",
      "sources" : [
        {
          "url" : "https://github.com/xiph/rav1e/archive/refs/tags/v0.7.1.tar.gz",
          "sha256" : "da7ae0df2b608e539de5d443c096e109442cdfa6c5e9b4014361211cf61d030c",
          "dest-filename" : "rav1e-0.7.1.tar.gz",
          "type" : "archive"
        }
      ],
      "build-options" : {
        "build-args" : [
          "--share=network"
        ]
      },
      "build-commands" : [
        "cargo capi install --release --prefix=/app --libdir=/app/lib --library-type=cdylib"
      ]
    },
    {
      "name" : "ffmpeg",
      "config-opts" : [
        "--enable-gpl",
        "--enable-shared",
        "--disable-static",
        "--disable-doc",
        "--disable-programs",
        "--enable-libx264",
        "--enable-libx265",
        "--enable-libsvtav1",
        "--enable-librav1e",
        "--enable-libaom",
        "--enable-libvpx",
        "--enable-libdav1d",
        "--enable-libmp3lame",
        "--enable-libopus",
        "--enable-libvorbis",
        "--enable-nvenc",
        "--enable-ffnvcodec",
        "--enable-libvpl",
        "--disable-vaapi",
        "--disable-vdpau",
        "--disable-xlib",
        "--disable-libxcb",
        "--disable-sdl2",
        "--disable-libdrm",
        "--disable-opencl",
        "--disable-vulkan",
        "--disable-cuda-llvm"
      ],
      "sources" : [
        {
          "url" : "https://ffmpeg.org/releases/ffmpeg-7.1.5.tar.xz",
          "sha256" : "de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f",
          "type" : "archive"
        }
      ]
    },
    {
      "name" : "smartcut",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : "../..",
          "skip" : [
            "rust/target",
            "gui/src-tauri/target",
            "gui/src-tauri/gen/schemas",
            "gui/node_modules",
            "dist",
            ".flatpak-builder",
            ".git"
          ],
          "type" : "dir"
        }
      ],
      "build-options" : {
        "env" : {
          "LIBCLANG_PATH" : "/usr/lib/sdk/llvm20/lib",
          "BINDGEN_EXTRA_CLANG_ARGS" : "-resource-dir=/usr/lib/sdk/llvm20/lib/clang/20"
        },
        "build-args" : [
          "--share=network"
        ],
        "append-path" : "/usr/lib/sdk/llvm20/bin"
      },
      "build-commands" : [
        "cargo build --release --manifest-path rust/Cargo.toml -p smartcut-cli",
        "cargo build --release --manifest-path gui/src-tauri/Cargo.toml --features tauri/custom-protocol",
        "install -Dm755 gui/src-tauri/target/release/gui /app/bin/smartcut",
        "install -Dm755 rust/target/release/smartcut /app/bin/smartcut-cli",
        "install -Dm644 gui/src-tauri/icons/32x32.png /app/share/icons/hicolor/32x32/apps/dev.smartcut.app.png",
        "install -Dm644 gui/src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/dev.smartcut.app.png",
        "install -Dm644 gui/src-tauri/icons/128x128@2x.png /app/share/icons/hicolor/256x256/apps/dev.smartcut.app.png",
        "install -Dm644 gui/flatpak/dev.smartcut.app.desktop /app/share/applications/dev.smartcut.app.desktop",
        "install -Dm644 gui/flatpak/dev.smartcut.app.metainfo.xml /app/share/metainfo/dev.smartcut.app.metainfo.xml"
      ]
    }
  ],
  "cleanup" : [
    "/include",
    "/lib/pkgconfig",
    "/lib/cmake",
    "/share/doc",
    "/share/man",
    "*.a",
    "*.la"
  ],
  "sdk-extensions" : [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm20"
  ],
  "finish-args" : [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=all",
    "--filesystem=host",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "source-date-epoch" : 1795346553
}